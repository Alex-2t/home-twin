{
  "name": "home-twin-editor",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.ts",
    "dev": "node build.ts --serve",
    "test": "node --test src/core/*.test.ts src/editor/*.test.ts src/look/*.test.ts src/i18n/*.test.ts",
    "format": "prettier --write \"src/**/*.ts\" \"demo/**/*.ts\" \"tools/**/*.ts\" \"*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"demo/**/*.ts\" \"tools/**/*.ts\" \"*.ts\"",
    "typecheck": "tsc -p .",
    "check": "npm run format:check && npm run typecheck && npm test"
  },
  "dependencies": {
    "polygon-clipping": "0.15.7",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/three": "0.186.0",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
